{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test"
  },
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts", "!src/fakes.ts"],
  "reporters": ["progress", "clear-text"],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["dist", ".stryker-tmp", "node_modules"]
}
