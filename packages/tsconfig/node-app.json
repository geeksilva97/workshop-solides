{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node App (native TypeScript via type stripping)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true
  }
}
